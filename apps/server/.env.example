# ============================================
# OZOBATH Server Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ozobath?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_here_change_this
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (Gmail / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ozobath@gmail.com
SMTP_PASS=your_app_password

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Super Admin (initial seed)
SUPER_ADMIN_NAME=OZOBATH Admin
SUPER_ADMIN_EMAIL=ozobath@gmail.com
SUPER_ADMIN_PASSWORD=OzoBath@2024
SUPER_ADMIN_PHONE=7899202927

# ─── Tax / GST ───────────────────────────────────
# All three default to the behaviour this codebase shipped with, so leaving
# them unset changes nothing. Confirm with your CA before flipping any of them.
#
# exclusive = GST added on top of product price (current behaviour)
# inclusive = GST extracted from the price (standard Indian retail MRP —
#             the listed price is what the customer pays)
TAX_MODE=exclusive
TAX_RATE=0.18
# Tax the delivery charge? GST normally treats delivery on a composite supply
# as taxable at the principal item's rate. Currently off = under-collecting.
TAX_ON_SHIPPING=false
# Tax the discounted value rather than the gross? CGST s.15(3)(a) excludes
# discounts recorded on the invoice at time of supply from taxable value.
TAX_AFTER_DISCOUNT=false
