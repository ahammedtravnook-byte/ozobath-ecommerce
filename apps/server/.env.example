# ============================================
# OZOBATH Server Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ozobath?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=your_access_token_secret_here_change_this
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret from the Razorpay dashboard (Settings > Webhooks).
# REQUIRED for /api/v1/payment/webhook — without it the endpoint rejects
# everything. The webhook is the safety net for a customer who pays and then
# closes the tab before the browser calls /confirm; without it that payment
# is captured with no order created.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Shiprocket ──────────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
PICKUP_PINCODE=560001
# Shared secret for the Shiprocket status webhook, sent by Shiprocket as the
# x-api-key header. Configure the same value in the Shiprocket dashboard.
#
# REQUIRED — /api/v1/shipping/webhook rejects every request when this is
# unset. That endpoint mutates order and shipment status (including marking
# COD orders paid on delivery), so it must never accept unauthenticated
# input. If tracking updates stop after deploy, this is why.
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# ─── CORS ────────────────────────────────────────
# Additional allowed origins, comma-separated, exact match only.
# CLIENT_URL and ADMIN_URL are always allowed. Wildcard suffixes such as
# *.vercel.app are deliberately NOT supported: they are shared public
# deployment domains that anyone can deploy to.
EXTRA_CORS_ORIGINS=

# ─── Cookies ─────────────────────────────────────
# Set true when the API and the SPAs are on DIFFERENT hostnames — including
# different subdomains of the same domain, e.g.
#   api.ozobath.com  +  admin.ozobath.com  +  www.ozobath.com
# Browsers treat those as cross-site, so the refresh cookie needs
# sameSite=None; Secure. That REQUIRES HTTPS on every origin — the server
# refuses to boot in production if CLIENT_URL/ADMIN_URL are not https://.
#
# Set false only when the API is served from the same origin as the SPA
# (e.g. ozobath.com/api behind one Nginx vhost), which is more secure.
COOKIE_CROSS_SITE=true

# Optional. `.ozobath.com` (leading dot) shares the refresh cookie across all
# subdomains. Leave EMPTY to scope it to the API host only — tighter, and the
# recommended default.
COOKIE_DOMAIN=

# Email (Gmail / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ozobath@gmail.com
SMTP_PASS=your_app_password

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Super Admin (initial seed)
SUPER_ADMIN_NAME=OZOBATH Admin
SUPER_ADMIN_EMAIL=ozobath@gmail.com
SUPER_ADMIN_PASSWORD=OzoBath@2024
SUPER_ADMIN_PHONE=7899202927

# ─── Order Limits ────────────────────────────────
# Maximum quantity for a single cart line item. Rejected with a 400 on every
# cart write path. `product.stock` is still the real constraint — this is a
# sanity ceiling so a client cannot submit a quantity large enough to distort
# the order arithmetic. Must be a positive integer.
MAX_ORDER_QUANTITY=50

# ─── Tax / GST ───────────────────────────────────
# All three default to the behaviour this codebase shipped with, so leaving
# them unset changes nothing. Confirm with your CA before flipping any of them.
#
# exclusive = GST added on top of product price (current behaviour)
# inclusive = GST extracted from the price (standard Indian retail MRP —
#             the listed price is what the customer pays)
TAX_MODE=exclusive
TAX_RATE=0.18
# Tax the delivery charge? GST normally treats delivery on a composite supply
# as taxable at the principal item's rate. Currently off = under-collecting.
TAX_ON_SHIPPING=false
# Tax the discounted value rather than the gross? CGST s.15(3)(a) excludes
# discounts recorded on the invoice at time of supply from taxable value.
TAX_AFTER_DISCOUNT=false
