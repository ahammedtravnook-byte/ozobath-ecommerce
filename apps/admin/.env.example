# ============================================
# OZOBATH Admin — environment
# ============================================
# Copy to .env and adjust. .env is gitignored.
#
#   cp .env.example .env

# Which API the admin talks to.
#
# LOCAL DEVELOPMENT — leave this commented out.
# vite.config.js proxies /api to http://localhost:5000, so the default
# relative path automatically reaches the server you are running locally.
#
# Setting an absolute URL here OVERRIDES that proxy. If it points at a
# deployed API, `npm run dev` silently tests against that remote server
# instead of your local changes — new query params are ignored and new
# response fields are missing, which looks like a frontend bug.
#
# VITE_API_URL=/api/v1

# STAGING / PRODUCTION builds — set the absolute API origin:
# VITE_API_URL=https://api.ozobath.in/api/v1

# Canonical site origin, used for absolute links.
# VITE_SITE_URL=https://ozobath.in
